[Unit]
Description=Raya attendance - API and web dashboard
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=attendance
Group=attendance
WorkingDirectory=/opt/attendance/current/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/attendance/api.env
# Only nginx (same machine) talks to it; nginx passes on the visitor's real IP address.
ExecStart=/opt/attendance/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=always
RestartSec=5
MemoryMax=900M

# Hardening: read-only system, no extra privileges.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_dev
DB_TEST_NAME=attendance_test

DB_OWNER_USER=attendance_owner
DB_OWNER_PASSWORD=change-me

DB_APP_USER=attendance_app
DB_APP_PASSWORD=change-me

# Password for the demo users created by the development seed (local only).
SEED_DEFAULT_PASSWORD=change-me

# Signs login tokens (JWT). At least 32 random characters. Production: Secret Manager.
JWT_SECRET=change-me-to-a-long-random-value

# Master key for the rotating office QR codes (40+ random characters). Production: Secret Manager.
QR_MASTER_KEY=change-me-to-a-long-random-value

# Google Play Integrity: "off" locally; "google" in production.
PLAY_INTEGRITY_MODE=off
PLAY_INTEGRITY_PACKAGE_NAME=com.raya.attendance


# --- Scheduled reports (Phase 15) ---
# Run end-of-day close + scheduled reports inside the API every minute (local development).
RUN_SCHEDULER_IN_API=true
# Ready-to-download report files are deleted after this many days.
REPORT_FILES_KEEP_DAYS=90
